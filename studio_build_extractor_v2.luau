--!strict
-- ==============================================================================
-- ROBLOX STUDIO BUILD EXTRACTOR & EXPORTER V2
-- ==============================================================================
-- Run this in Roblox Studio Command Bar or via Executor in live game.
-- Reads 'workspace.builds' and extracts all structures into:
--   1. Absolute positions (world space)
--   2. Relative offsets from computed Centroid or Player Root
--   3. Automatically generates an executable Luau script ready for auto_build_v2
-- ==============================================================================

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local BuildsFolder = Workspace:FindFirstChild("builds")
if not BuildsFolder then
    error("[StudioExtractor V2] Could not find 'workspace.builds'! Make sure the folder exists.")
end

local CONFIG = {
    ExcludeBasicTurret = true,
    Precision = 2, -- Decimals for position
    RotPrecision = 3, -- Decimals for rotation
    OutputFileName = "StudioExtractedBuilds_V2.luau"
}

print("================================================================================")
print("[StudioExtractor V2] Scanning 'workspace.builds'...")
print("================================================================================")

type StructureData = {
    c: string, -- category / name
    x: number, y: number, z: number,
    rx: number, ry: number, rz: number
}

local rawItems: { StructureData } = {}
local totalFound = 0
local excludedCount = 0
local sumPos = Vector3.zero

for _, obj in ipairs(BuildsFolder:GetChildren()) do
    local name = obj.Name
    if CONFIG.ExcludeBasicTurret and name == "Basic Turret" then
        excludedCount += 1
    else
        local cf: CFrame?
        if obj:IsA("Model") then
            cf = obj.PrimaryPart and obj.PrimaryPart.CFrame or obj:GetPivot()
        elseif obj:IsA("BasePart") then
            cf = obj.CFrame
        end

        if cf then
            totalFound += 1
            sumPos += cf.Position
            local rx, ry, rz = cf:ToEulerAnglesXYZ()
            local multPos = 10 ^ CONFIG.Precision
            local multRot = 10 ^ CONFIG.RotPrecision
            
            table.insert(rawItems, {
                c = name,
                x = math.round(cf.Position.X * multPos) / multPos,
                y = math.round(cf.Position.Y * multPos) / multPos,
                z = math.round(cf.Position.Z * multPos) / multPos,
                rx = math.round(rx * multRot) / multRot,
                ry = math.round(ry * multRot) / multRot,
                rz = math.round(rz * multRot) / multRot,
            })
        end
    end
end

local centroid = (totalFound > 0) and (sumPos / totalFound) or Vector3.zero

print(string.format("[StudioExtractor V2] Scanned %d valid structures (%d excluded).", totalFound, excludedCount))
print(string.format("[StudioExtractor V2] Centroid computed at Vector3.new(%.2f, %.2f, %.2f)", centroid.X, centroid.Y, centroid.Z))

local lines = {}
table.insert(lines, "--!strict")
table.insert(lines, "-- Generated by Studio Build Extractor V2")
table.insert(lines, string.format("-- Total Parts: %d | Centroid: (%.2f, %.2f, %.2f)", totalFound, centroid.X, centroid.Y, centroid.Z))
table.insert(lines, "")
table.insert(lines, "local RAW_BUILD_DATA = {")

for _, item in ipairs(rawItems) do
    table.insert(lines, string.format('    {"%s", %.2f, %.2f, %.2f, %.3f, %.3f, %.3f},',
        item.c, item.x, item.y, item.z, item.rx, item.ry, item.rz))
end

table.insert(lines, "}")
table.insert(lines, "")
table.insert(lines, "local AutoBuild = require(script.Parent:WaitForChild(\"auto_build_v2\"))")
table.insert(lines, "AutoBuild.executeBuild(RAW_BUILD_DATA)")
table.insert(lines, "return RAW_BUILD_DATA")

local fullCode = table.concat(lines, "\n")

if writefile then
    pcall(function()
        writefile(CONFIG.OutputFileName, fullCode)
        print("[StudioExtractor V2] Saved payload directly to file: " .. CONFIG.OutputFileName)
    end)
else
    print("[StudioExtractor V2] Copy output from console or use ServerScriptService script.")
end

print("================================================================================")
print("[StudioExtractor V2] Extraction Complete!")
print("================================================================================")

return fullCode
